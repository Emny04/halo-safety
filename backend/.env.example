OPENAI_API_KEY=sk-your-key-here

# --- Gmail (Google) OAuth2 ---
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:8000/oauth/gmail/callback as an Authorized redirect URI
# 4. Enable the Gmail API at https://console.cloud.google.com/apis/library/gmail.googleapis.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outlook (Microsoft) OAuth2 ---
# 1. Go to https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# 2. Register an app → Add a Web redirect URI: http://localhost:8000/oauth/outlook/callback
# 3. Under API permissions, add Microsoft Graph → Mail.Read (delegated)
# 4. Under Certificates & secrets, create a client secret
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
